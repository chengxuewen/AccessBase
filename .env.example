# Database
DATABASE_URL=postgresql://accessbase:accessbase_dev@localhost:5432/accessbase

# Redis
REDIS_URL=redis://:accessbase_dev@localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=5101
HOST=0.0.0.0
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Deploy mode: first admin auto-creation
ADMIN_EMAIL=admin@accessbase.local
ADMIN_PASSWORD=change-me

# Deploy mode: static assets directory
STATIC_DIR=out/admin-ui
