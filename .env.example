# =============================================================================
# AccessBase Environment Variables
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# -- Core Runtime ---------------------------------------------------------------

# Required | Application port (default: 5101)
PORT=5101

# Required | Bind address (default: 0.0.0.0 for container, 127.0.0.1 for local dev)
HOST=0.0.0.0

# Required | Node environment: development | test | production
NODE_ENV=development

# Required | PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgresql://accessbase:accessbase_dev@localhost:5432/accessbase

# Required | Redis connection string
# Format: redis://[:PASSWORD@]HOST[:PORT][/DB]
REDIS_URL=redis://localhost:6379

# -- JWT / Signing --------------------------------------------------------------

# Required | Symmetric secret for HMAC fallback when RSA keys are not configured.
# Min 32 bytes recommended. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional | Path to RSA private key file (PEM) for RS256 JWT signing.
# When set, JWT_PUBLIC_KEY_PATH must also be set; JWT_SECRET becomes fallback only.
JWT_PRIVATE_KEY_PATH=

# Optional | Path to RSA public key file (PEM) for RS256 JWT verification.
# When set, JWT_PRIVATE_KEY_PATH must also be set.
JWT_PUBLIC_KEY_PATH=

# -- MFA / TOTP ----------------------------------------------------------------

# Optional | 32-byte hex key for AES-256-GCM encryption of TOTP secrets.
# Required for MFA endpoints; without it /auth/mfa/setup returns 400.
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# -- Admin Bootstrap (first-run only) -------------------------------------------

# Optional | Admin account email for initial setup wizard.
ADMIN_EMAIL=admin@example.com

# Optional | Admin account password for initial setup wizard.
ADMIN_PASSWORD=

# -- Frontend / Static ----------------------------------------------------------

# Required | Path to built admin-ui static files (default: out/admin-ui)
STATIC_DIR=out/admin-ui

# Optional | Comma-separated list of allowed CORS origins.
# Example: http://localhost:5173,https://app.example.com
CORS_ORIGINS=

# Optional | Frontend origin used for OAuth redirect backlinks (default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# -- OAuth: GitHub --------------------------------------------------------------

# Optional | GitHub OAuth App credentials (enable GitHub login).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -- OAuth: Google --------------------------------------------------------------

# Optional | Google OAuth App credentials (enable Google login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional | Base URL for OAuth callback redirect (default: http://localhost:5101)
OAUTH_REDIRECT_BASE=http://localhost:5101

# -- WebAuthn / Passkey ---------------------------------------------------------

# Optional | WebAuthn relying party display name (default: AccessBase)
WEBAUTHN_RP_NAME=AccessBase

# Optional | WebAuthn relying party identifier / domain (default: localhost)
WEBAUTHN_RP_ID=localhost

# Optional | WebAuthn origin for credential validation (default: http://localhost:5173)
WEBAUTHN_ORIGIN=http://localhost:5173

# -- Security: Account Lockout --------------------------------------------------

# Optional | Max failed login attempts before lockout (default: 5)
LOCKOUT_MAX_FAILURES=5

# Optional | Lockout window in seconds (default: 900 = 15 min)
LOCKOUT_WINDOW_SECONDS=900

# -- Logging --------------------------------------------------------------------

# Optional | Pino log level for the logging package.
# Note: server config.ts derives its logLevel from NODE_ENV; this key is read by
# @accessbase/logging when loaded standalone. Values: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# -- Reserved (unwired) ---------------------------------------------------------
# The following keys are not read by any code; the actual token TTLs are
# hardcoded '15m' in auth.ts. Kept for future wiring.
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# -- Database Migration (packages/migration CLI) --------------------------------

# Optional | Enable schema backup before migration (default: true)
# MIGRATION_BACKUP_ENABLED=true

# Optional | Backup output directory (default: ./backups)
# MIGRATION_BACKUP_DIR=./backups

# Optional | Backup retention in days (default: 30)
# MIGRATION_BACKUP_RETENTION_DAYS=30

# Optional | Migration scripts directory (default: ./migrations)
# MIGRATIONS_DIR=./migrations

# Optional | Name of the migrations tracking table (default: _migrations)
# MIGRATIONS_TABLE=_migrations

# Optional | Migration lock timeout in ms (default: 30000)
# MIGRATION_LOCK_TIMEOUT=30000

# Optional | Enable SSL for database connection during migration (default: false)
# DATABASE_SSL=false

# Optional | Max database connections during migration (default: 10)
# DATABASE_MAX_CONNECTIONS=10

# Optional | Log level for migration CLI output (default: info)
# MIGRATION_LOG_LEVEL=info

# Optional | Write migration logs to file (no default)
# MIGRATION_LOG_FILE=migration.log

# -- Email (SMTP) ----------------------------------------------------------------
# SMTP is wired: forgot-password sends mail when a host is configured.
# Options-table keys (smtp_host, smtp_port, smtp_user, smtp_password,
# smtp_from) take precedence over these env fallbacks (env > option > default).

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
