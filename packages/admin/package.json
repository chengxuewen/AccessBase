{
  "name": "@accessbase/admin",
  "version": "0.1.0",
  "description": "Admin UI framework for AccessBase — shell, menu, theme, brand, page registry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@accessbase/identity": "workspace:*",
    "@accessbase/audit": "workspace:*",
    "@accessbase/i18n": "workspace:*",
    "@accessbase/logging": "workspace:*",
    "fastify": "^4.25.0",
    "fastify-plugin": "^4.5.1",
    "@fastify/static": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0"
  }
}
