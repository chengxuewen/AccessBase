{
  "name": "@accessbase/identity",
  "version": "0.1.0",
  "description": "Authentication and authorization core package for AccessBase",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@accessbase/shared-types": "workspace:*",
    "@accessbase/logging": "workspace:*",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "ioredis": "^5.3.2",
    "fastify": "^4.25.0",
    "fastify-plugin": "^4.5.1",
    "drizzle-orm": "^0.29.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.7.0"
  }
}