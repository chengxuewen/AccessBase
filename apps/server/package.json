{
  "name": "@accessbase/server",
  "version": "0.1.0",
  "description": "AccessBase API server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@accessbase/audit": "workspace:*",
    "@accessbase/health": "workspace:*",
    "@accessbase/i18n": "workspace:*",
    "@accessbase/identity": "workspace:*",
    "@accessbase/logging": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9",
    "@fastify/static": "^6.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "arctic": "^3.7.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.29.0",
    "fastify": "^4.25.0",
    "pg": "^8.11.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "otplib": "^13.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0"
  }
}
