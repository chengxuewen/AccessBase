{
  "mcpServers": {
    "local-codegraph": {
      "command": "bash",
      "args": [
        "scripts/agents/mcp-launch.sh",
        "node",
        ".opencode/init-mcp-codegraph.mjs"
      ]
    },
    "local-playwright": {
      "command": "bash",
      "args": [
        "scripts/agents/mcp-launch.sh",
        "node",
        ".opencode/init-mcp-playwright.mjs"
      ]
    },
    "local-drizzle": {
      "command": "bash",
      "args": [
        "scripts/agents/mcp-launch.sh",
        "node",
        ".opencode/init-mcp-drizzle.mjs"
      ]
    },
    "local-serena": {
      "command": "bash",
      "args": [
        "scripts/agents/mcp-launch.sh",
        "-e",
        "serena",
        "mcp-serena"
      ]
    }
  }
}
