{
  "$schema": "https://opencode.ai/config.json",
  "model": "new-api/premium",
  "compaction": { "auto": true },
  "enabled_providers": ["new-api", "deepseek"],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
    "oh-my-openagent@4.19.4",
    "context-mode"
  ],
  "instructions": [
    ".agents/memorys/status.md",
    ".agents/memorys/conventions.md",
    ".agents/rules/common/security.md",
    ".agents/rules/common/coding-style.md",
    ".agents/rules/typescript/coding-style.md",
    ".agents/rules/common/agents.md",
    ".agents/rules/common/code-review.md",
    ".agents/rules/common/development-workflow.md",
    ".agents/rules/common/git-workflow.md",
    ".agents/rules/common/hooks.md",
    ".agents/rules/common/patterns.md",
    ".agents/rules/common/performance.md",
    ".agents/rules/common/testing.md",
    ".agents/rules/common/edit-safety.md",
    ".agents/rules/common/lesson-memory.md",
    ".agents/rules/common/skills-router.md",
    ".agents/rules/common/constraints.md",
    ".agents/rules/common/docker.md",
    ".agents/rules/common/platform.md"
  ],
  "mcp": {
    "local-codegraph": {
      "type": "local",
      "enabled": true,
      "command": ["pixi", "run", "node", ".opencode/init-mcp-codegraph.mjs"]
    },
    "local-playwright": {
      "type": "local",
      "enabled": true,
      "command": ["pixi", "run", "node", ".opencode/init-mcp-playwright.mjs"]
    },
    "local-postgres": {
      "type": "local",
      "enabled": false,
      "command": ["pixi", "run", "node", ".opencode/init-mcp-postgres.mjs"]
    },
    "local-antd": {
      "type": "local",
      "enabled": true,
      "command": ["pixi", "run", "node", ".opencode/init-mcp-antd.mjs"]
    },
    "local-drizzle": {
      "type": "local",
      "enabled": true,
      "command": ["pixi", "run", "node", ".opencode/init-mcp-drizzle.mjs"]
    },
    "local-openspace": {
      "type": "local",
      "enabled": true,
      "command": ["pixi", "run", "node", ".opencode/init-mcp-openspace.mjs"]
    },
    "local-github": {
      "type": "local",
      "enabled": true,
      "command": ["pixi", "run", "npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "lsp": {
    "typescript-language-server": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": ["ts", "tsx", "js", "jsx"]
    },
    "pyright": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": ["py"]
    },
    "bash-language-server": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "bash-language-server",
        "start"
      ],
      "extensions": ["sh", "bash"]
    },
    "rust-analyzer": {
      "command": ["pixi", "run", "node", ".opencode/init-lsp-wrap.mjs", "rust-analyzer"],
      "extensions": ["rs"]
    },
    "html-language-server": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "vscode-html-language-server",
        "--stdio"
      ],
      "extensions": ["html", "htm"]
    },
    "remark-language-server": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "remark-language-server",
        "--stdio"
      ],
      "extensions": ["md", "markdown"]
    },
    "gopls": {
      "command": ["pixi", "run", "node", ".opencode/init-lsp-wrap.mjs", "gopls"],
      "extensions": ["go"]
    },
    "clangd": {
      "command": ["pixi", "run", "node", ".opencode/init-lsp-wrap.mjs", "clangd", "--background"],
      "extensions": ["c", "cpp", "cc", "cxx", "h", "hpp"]
    }
  }
}
