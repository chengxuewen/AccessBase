{
  "$schema": "https://opencode.ai/config.json",
  "model": "new-api/premium",
  "compaction": {
    "auto": true
  },
  "enabled_providers": [
    "new-api",
    "deepseek"
  ],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
    "oh-my-openagent@4.19.4",
    "context-mode"
  ],
  "instructions": [
    "CONSTRAINTS.md",
    ".agents/memorys/status.md",
    ".agents/memorys/conventions.md",
    ".agents/rules/common/agents.md",
    ".agents/rules/common/code-review.md",
    ".agents/rules/common/coding-style.md",
    ".agents/rules/common/constraints.md",
    ".agents/rules/common/development-workflow.md",
    ".agents/rules/common/docker.md",
    ".agents/rules/common/edit-safety.md",
    ".agents/rules/common/git-workflow.md",
    ".agents/rules/common/hooks.md",
    ".agents/rules/common/lesson-memory.md",
    ".agents/rules/common/patterns.md",
    ".agents/rules/common/performance.md",
    ".agents/rules/common/platform.md",
    ".agents/rules/common/security.md",
    ".agents/rules/common/skills-router.md",
    ".agents/rules/common/testing.md",
    ".agents/rules/common/tool-routing.md",
    ".agents/rules/csharp/coding-style.md",
    ".agents/rules/csharp/hooks.md",
    ".agents/rules/csharp/patterns.md",
    ".agents/rules/csharp/security.md",
    ".agents/rules/csharp/testing.md",
    ".agents/rules/dart/coding-style.md",
    ".agents/rules/dart/hooks.md",
    ".agents/rules/dart/patterns.md",
    ".agents/rules/dart/security.md",
    ".agents/rules/dart/testing.md",
    ".agents/rules/golang/coding-style.md",
    ".agents/rules/golang/hooks.md",
    ".agents/rules/golang/patterns.md",
    ".agents/rules/golang/security.md",
    ".agents/rules/golang/testing.md",
    ".agents/rules/java/coding-style.md",
    ".agents/rules/java/hooks.md",
    ".agents/rules/java/patterns.md",
    ".agents/rules/java/security.md",
    ".agents/rules/java/testing.md",
    ".agents/rules/kotlin/coding-style.md",
    ".agents/rules/kotlin/hooks.md",
    ".agents/rules/kotlin/patterns.md",
    ".agents/rules/kotlin/security.md",
    ".agents/rules/kotlin/testing.md",
    ".agents/rules/perl/coding-style.md",
    ".agents/rules/perl/hooks.md",
    ".agents/rules/perl/patterns.md",
    ".agents/rules/perl/security.md",
    ".agents/rules/perl/testing.md",
    ".agents/rules/php/coding-style.md",
    ".agents/rules/php/hooks.md",
    ".agents/rules/php/patterns.md",
    ".agents/rules/php/security.md",
    ".agents/rules/php/testing.md",
    ".agents/rules/python/coding-style.md",
    ".agents/rules/python/hooks.md",
    ".agents/rules/python/patterns.md",
    ".agents/rules/python/security.md",
    ".agents/rules/python/testing.md",
    ".agents/rules/rust/coding-style.md",
    ".agents/rules/rust/hooks.md",
    ".agents/rules/rust/patterns.md",
    ".agents/rules/rust/security.md",
    ".agents/rules/rust/testing.md",
    ".agents/rules/swift/coding-style.md",
    ".agents/rules/swift/hooks.md",
    ".agents/rules/swift/patterns.md",
    ".agents/rules/swift/security.md",
    ".agents/rules/swift/testing.md",
    ".agents/rules/typescript/coding-style.md",
    ".agents/rules/typescript/hooks.md",
    ".agents/rules/typescript/patterns.md",
    ".agents/rules/typescript/security.md",
    ".agents/rules/typescript/testing.md",
    ".agents/rules/web/coding-style.md",
    ".agents/rules/web/design-quality.md",
    ".agents/rules/web/hooks.md",
    ".agents/rules/web/patterns.md",
    ".agents/rules/web/performance.md",
    ".agents/rules/web/security.md",
    ".agents/rules/web/testing.md"
  ],
  "mcp": {
    "local-codegraph": {
      "type": "local",
      "enabled": true,
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-mcp-codegraph.mjs"
      ]
    },
    "local-playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-mcp-playwright.mjs"
      ]
    },
    "local-antd": {
      "type": "local",
      "enabled": false,
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-mcp-antd.mjs"
      ]
    },
    "local-drizzle": {
      "type": "local",
      "enabled": true,
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-mcp-drizzle.mjs"
      ]
    },
    "local-postgres": {
      "type": "local",
      "enabled": false,
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-mcp-postgres.mjs"
      ]
    },
    "local-github": {
      "type": "remote",
      "enabled": false,
      "command": [
        "npx",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "lsp": {
    "typescript-language-server": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        "ts",
        "tsx",
        "js",
        "jsx"
      ]
    },
    "pyright": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        "py"
      ]
    },
    "bash-language-server": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "bash-language-server",
        "start"
      ],
      "extensions": [
        "sh",
        "bash"
      ]
    },
    "rust-analyzer": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "rust-analyzer"
      ],
      "extensions": [
        "rs"
      ]
    },
    "html-language-server": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [
        "html",
        "htm"
      ]
    },
    "remark-language-server": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "remark-language-server",
        "--stdio"
      ],
      "extensions": [
        "md",
        "markdown"
      ]
    },
    "gopls": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "gopls"
      ],
      "extensions": [
        "go"
      ]
    },
    "clangd": {
      "command": [
        "pixi",
        "run",
        "node",
        ".opencode/init-lsp-wrap.mjs",
        "clangd",
        "--background"
      ],
      "extensions": [
        "c",
        "cpp",
        "cc",
        "cxx",
        "h",
        "hpp"
      ]
    }
  }
}
